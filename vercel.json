{
  "routes": [
    {
      "src": "/agency\\.html",
      "status": 308,
      "headers": {
        "Location": "https://agencia.melieremarketing.com.br/"
      }
    },
    {
      "src": "/(social-media|identidade-visual|trafego-pago|sites|briefing|politica-de-privacidade)\\.html",
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "agencia.melieremarketing.com.br"
        }
      ],
      "dest": "/agency.html"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "meliere-marketing-.+\\.vercel\\.app"
        }
      ],
      "dest": "/agency.html"
    },
    {
      "src": "/site/?",
      "status": 308,
      "headers": {
        "Location": "https://agencia.melieremarketing.com.br/"
      }
    },
    {
      "src": "/(social-media|identidade-visual|trafego-pago|sites|briefing|politica-de-privacidade)/?",
      "dest": "/$1.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
